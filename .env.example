# .env.example

# PostgreSQL Database for MCP Server
POSTGRES_DB=mcp_database
POSTGRES_USER=mcp_user
POSTGRES_PASSWORD=supersecretpassword

# This forms the connection string for the apps
DATABASE_URL=postgresql://mcp_user:supersecretpassword@mcp-db/mcp_database

# Redis URL for Celery Task Queue
REDIS_URL=redis://redis:6379/0

# AI Provider Keys
OPENAI_API_KEY="YOUR_API_KEY_HERE"